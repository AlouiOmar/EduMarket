NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/edumarket
JWT_SECRET=mysecretkeyedumarketlmsplatform1
CORS_ORIGIN=http://localhost:3000

APP_ORIGIN=http://localhost:3000
# Configure a verified sender and Resend API key for production email delivery.
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=EduMarket <verified-sender@example.com>
# Optional: self-hosted Jitsi base URL. In production it must use HTTPS.
# JITSI_BASE_URL=https://meet.example.com
# Local private-storage adapter root; mount persistent private storage in production.
PRIVATE_UPLOAD_DIR=./private-uploads

# Payments: none (checkout fails closed), sandbox (development only, refused in production) or stripe.
PAYMENT_PROVIDER=none
PAYMENT_CURRENCY=eur
# Required with PAYMENT_PROVIDER=stripe. Webhook endpoint: POST {API}/api/v1/payments/webhooks/stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional with sandbox: enables signed POST {API}/api/v1/payments/webhooks/sandbox (X-Sandbox-Signature)
# SANDBOX_WEBHOOK_SECRET=change-me-at-least-16-chars
# Seller earnings become available after the refund window; payouts are settled manually by the finance team.
PAYOUT_HOLD_DAYS=7
PAYOUT_MINIMUM_CENTS=2000

# Optional Google Calendar sync (OAuth client of type "Web application"; enable the Google Calendar API).
# Scopes requested: calendar.calendarlist.readonly + calendar.events (or calendar.events.readonly for read-only connections).
# GOOGLE_REDIRECT_URI must be {API}/api/v1/calendar/google/callback and registered in Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/calendar/google/callback

# Offline payments (cash, cheque, bank transfer): days a student's request stays open before it expires.
OFFLINE_PAYMENT_DAYS=14

# Optional cloud storage for teachers/institutions (course files, grade exports).
# Google Drive reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET (enable the Google Drive API, scope drive.file).
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/api/v1/storage/oauth/google_drive/callback
# OneDrive: Microsoft Entra app registration (Web platform), delegated permissions Files.ReadWrite, User.Read, offline_access.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:4000/api/v1/storage/oauth/onedrive/callback
# MICROSOFT_TENANT=common
# Outlook / Microsoft 365 calendars and Teams meetings reuse the same Entra app with a second redirect URI.
# Delegated permissions: offline_access, User.Read, Calendars.ReadWrite (Calendars.Read for read-only connections).
# MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:4000/api/v1/calendar/microsoft/callback

# Calendar sync (all optional; the EduMarket calendar works without any of them).
# Public HTTPS base URL of this API for Google/Microsoft change notifications, e.g. https://edumarket-api.onrender.com/api/v1
# Without it, sync runs on schedule (every ~15 min while the server is awake), when the calendar opens, or on demand.
# CALENDAR_WEBHOOK_BASE_URL=
# Secret (32+ characters) for POST /api/v1/calendar/sync/cron, header X-Calendar-Cron-Secret, called by an external scheduler.
# CALENDAR_CRON_SECRET=
# Dedicated key (32+ characters) encrypting provider tokens at rest. Without it a key derived from JWT_SECRET is used;
# tokens encrypted before the key was set stay readable.
# CALENDAR_TOKEN_KEY=

# --- LMS integrations (mission 2). All optional: without them each feature reports itself as not operational. ---
# AI conversation activities (server-side only; the key never reaches the browser).
# AI_PROVIDER=anthropic            # none | anthropic | openai-compatible
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5-5       # required for openai-compatible (e.g. a Mistral/OpenAI/Ollama model name)
# AI_BASE_URL=                     # openai-compatible only, e.g. https://api.mistral.ai/v1 or http://127.0.0.1:11434/v1
# AI_MAX_OUTPUT_TOKENS=800
# AI_TIMEOUT_MS=20000
# LTI 1.3 platform: RSA private key in PEM (newlines may be written as 
), its key id and this platform's public URL.
# Generate a key: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out lti.pem
# LTI_PRIVATE_KEY=
# LTI_KEY_ID=edumarket-lti-1
# LTI_ISSUER=https://api.example.org
# SCORM content is served only from a separate host name without the session cookie (e.g. a dedicated sub-domain).
# SCORM_CONTENT_ORIGIN=https://scorm-content.example.org
# Link checker: never enable in production (SSRF protection); tests only.
# LINK_CHECK_ALLOW_PRIVATE=false

# --- Independent teacher applications (identity documents, diplomas, CVs) ---
# local: PRIVATE_UPLOAD_DIR/teacher-applications. In production it is accepted only when PRIVATE_UPLOAD_PERSISTENT=true
# declares a persistent disk (NOT Render's ephemeral file system); otherwise final submissions are refused (503).
# s3: any S3-compatible PRIVATE bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO). Never make the bucket public.
TEACHER_DOCUMENTS_STORAGE=local
PRIVATE_UPLOAD_PERSISTENT=false
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Separate environments sharing a bucket, e.g. prod/teacher-applications/
S3_PREFIX=teacher-applications/
S3_FORCE_PATH_STYLE=true
TEACHER_DOCUMENT_MAX_MB=10
# 32+ characters; encrypts identity document numbers at rest (derived from JWT_SECRET when empty). Keep it stable.
TEACHER_DATA_KEY=
# Refused/abandoned files lose documents and identity data after this many days (set it to your legal obligations).
TEACHER_APPLICATION_RETENTION_DAYS=365
# Waiting period before a refused account may apply again.
TEACHER_APPLICATION_REAPPLY_DAYS=90
